    <string name="about">About</string>
    <string name="about_features">Features</string>
    <string name="about_intro">TokenFlow is a bring-your-own-key Android AI client that connects directly to model services you configure. Model requests are sent to the service endpoints you choose.</string>
    <string name="about_feature_multi_model_title">Direct multi-model access</string>
    <string name="about_feature_multi_model_body">Supports OpenAI Chat Completions, OpenAI Responses, and Anthropic Messages-compatible APIs, with configurable providers, models, and output limits.</string>
    <string name="about_feature_chat_title">Complete conversations</string>
    <string name="about_feature_chat_body">Includes streaming responses, reasoning and tool activity, stop and retry, automatic titles, branches, pins, archives, search, context breaks, image, document, and note attachments, plus token and cache statistics.</string>
    <string name="about_feature_workspace_title">Local workspace</string>
    <string name="about_feature_workspace_body">Includes saved replies, Markdown notes, agents, and local knowledge. Notes can use a selected model for titles and rewrites and can be copied into local knowledge.</string>
    <string name="about_feature_extensions_title">Optional extensions</string>
    <string name="about_feature_extensions_body">Supports Exa web search, web-content reading, vision fallback, and Xiaomi MiMo speech generation, together with system prompts, avatars, typography controls, and encrypted configuration import and export.</string>
    <string name="about_model_tools">Model tools</string>
    <string name="about_model_tool_web_search_title">Web search</string>
    <string name="about_model_tool_web_search_body">Available when web search is enabled for the current chat, an Exa API key is configured, and the maximum tool-call count is above zero. The query and API key are sent to Exa; returned titles, URLs, dates, and highlights are passed to the configured model service.</string>
    <string name="about_model_tool_read_url_title">URL reading</string>
    <string name="about_model_tool_read_url_body">Available when URL reading is enabled for the current chat and the maximum tool-call count is above zero. The app fetches the public HTTPS URL directly, or sends it to InfoFlow when that reader is selected; extracted content is passed to the configured model service. Do not put credentials or personal data in the URL.</string>
    <string name="about_model_tool_search_knowledge_title">Local knowledge search</string>
    <string name="about_model_tool_search_knowledge_body">Available when local knowledge is enabled for the current chat, local knowledge storage is available, and the maximum tool-call count is above zero. The app searches its on-device index without using a separate search service; matched passages, document names, and citation markers are passed to the configured model service.</string>
    <string name="about_service_keys">Service API keys</string>
